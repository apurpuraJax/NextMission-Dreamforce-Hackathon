<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>NM Agent Data Access</label>
    <description>Agent access boundary for NM_ objects. Contact_Email__c excluded by design — agents must never surface it. Admins needing that field use a separate permset. Assign to the agent user before activation; unassigned = silent no-ops.</description>

    <!-- Apex class access — agents must reach every Apex action they invoke -->
    <classAccesses>
        <apexClass>NM_FindMentorAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NM_GetJobMatchesAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NM_LogConversationAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NM_LookupMilitaryCodeAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NM_QAEvaluator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NM_QAScheduler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NM_RequestMentorIntroAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NM_TranslateSkillsAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Custom Metadata Type access (read-only — CMDT records are always read-only at runtime) -->
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>NM_Military_Code__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>NM_Specialty_Cluster__mdt</name>
    </customMetadataTypeAccesses>

    <!-- NM_Conversation__c: Create, Read, Edit (agents write sessions, read for context) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>NM_Conversation__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- NM_Mentor__c: Read only (agents surface mentor info; never write to the roster) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>NM_Mentor__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- NM_Mentor_Introduction__c: Create, Read, Edit -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>NM_Mentor_Introduction__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- NM_Conversation__c field permissions — operational + QA fields (NMDH-19 deployed) -->
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Branch__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Cluster_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.External_Session_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Lead_Captured__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Mentor_Matched__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Mentor_Requested__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Message_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Source_URL__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Specialty_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Started_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Transcript__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- NM_Conversation__c QA fields (NMDH-19) — read/edit for grader + admin reporting -->
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.QA_Issue_Categories__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.QA_Issues__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.QA_Reviewed_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.QA_Reviewed__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.QA_Score__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Sentiment__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Summary__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- NM_Mentor__c field permissions — Contact_Email__c intentionally excluded -->
    <fieldPermissions>
        <editable>false</editable>
        <field>NM_Mentor__c.Active__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>NM_Mentor__c.Bio__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>NM_Mentor__c.Branch__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>NM_Mentor__c.Civilian_Role__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>NM_Mentor__c.Employer__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>NM_Mentor__c.Specialty_Cluster__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>NM_Mentor__c.Years_Since_Transition__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- NM_Mentor__c.Contact_Email__c: NOT listed — agents must never surface mentor email -->

    <!-- NM_Mentor_Introduction__c field permissions -->
    <!-- Conversation__c and Mentor__c are required lookups — Salesforce does not allow  -->
    <!-- explicit fieldPermissions on required fields; they are always accessible.        -->
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Mentor_Introduction__c.Introduced_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Mentor_Introduction__c.Requester_Email__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Mentor_Introduction__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- System permissions — Run Flows required so the agent running user can invoke NM_GetCluster_Flow -->
    <userPermissions>
        <enabled>true</enabled>
        <name>RunFlow</name>
    </userPermissions>
    <!-- ExecutePromptTemplates required for NM_QAEvaluator to call ConnectApi.EinsteinLLM.generateMessagesForPromptTemplate (NMDH-19) -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ExecutePromptTemplates</name>
    </userPermissions>
</PermissionSet>
