<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>NM Admin Data Access</label>
    <description>Admin access to all NM_ objects and fields including Contact_Email__c. Use for mentor roster management, demo seeding, and judging review. Assign to human admins only — NOT to the agent user.</description>

    <!-- Custom Metadata Types (read-only at runtime — both types) -->
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>NM_Military_Code__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>NM_Specialty_Cluster__mdt</name>
    </customMetadataTypeAccesses>

    <!-- NM_Conversation__c: Full CRU + ViewAll (admins need to see all sessions) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>NM_Conversation__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- NM_Mentor__c: Full CRU + ViewAll (admins manage the roster) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>NM_Mentor__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- NM_Mentor_Introduction__c: Full CRU + ViewAll (admins review intro audit log) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>NM_Mentor_Introduction__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- NM_Conversation__c field permissions (all fields, read + edit) -->
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Branch__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Cluster_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.External_Session_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Lead_Captured__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Mentor_Matched__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Mentor_Requested__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Message_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Source_URL__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Specialty_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Started_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Conversation__c.Transcript__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- NM_Mentor__c field permissions — Contact_Email__c INCLUDED (admin permset) -->
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Mentor__c.Active__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NM_Mentor__c.Bio__c</field>
