            <developerName>No_Off_Limits_Words</developerName>
            <language xsi:nil="true"/>
            <masterLabel>No Off Limits Words</masterLabel>
            <sortOrder>5</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
