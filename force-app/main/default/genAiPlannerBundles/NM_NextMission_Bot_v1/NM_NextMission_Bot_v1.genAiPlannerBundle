        <description>Surfaces civilian job options tied to the visitor&apos;s specialty cluster. Called when the visitor asks to see job roles that match their military background.</description>
        <developerName>NM_Job_Matching</developerName>
        <genAiPluginInstructions>
            <description>Call NM_GetJobMatches with the established clusterKey. Present the returned job titles and descriptions verbatim — do not add, remove, or rephrase them.</description>
            <developerName>Present_Jobs_From_Data</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Present Jobs From Data</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Do not rank jobs in any way. Do not describe any job as the top, most suitable, most recommended, or most relevant option. Present them as a set of options only.</description>
            <developerName>No_Ranking</developerName>
            <language xsi:nil="true"/>
            <masterLabel>No Ranking</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Do not state or imply any salary, compensation range, hourly rate, or pay scale for any role.</description>
            <developerName>No_Salary_Claims</developerName>
            <language xsi:nil="true"/>
